{
  "name": "iressa",
  "private": true,
  "license": "MIT",
  "homepage": "https://iressa.quicx.dev/",
  "repository": { "type": "git", "url": "git+https://github.com/SborJ/Iressa.git" },
  "bugs": { "url": "https://github.com/SborJ/Iressa/issues" },
  "version": "0.1.0",
  "type": "module",
  "description": "Data-driven 3D tumour simulation and renderer. All biology lives in rules.json; all appearance lives in visuals.json.",
  "scripts": {
    "start": "bash scripts/start.sh",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "tsx scripts/run-sim.ts",
    "record": "tsx scripts/record-run.ts",
    "setup:orcid": "node scripts/setup-orcid-provider.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "ajv": "^8.17.1",
    "motion": "^14.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
