    "sim": "tsx scripts/run-sim.ts",
    "record": "tsx scripts/record-run.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/three": "^0.170.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}