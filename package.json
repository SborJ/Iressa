{
  "name": "iressa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Data-driven 3D tumour simulation and renderer. All biology lives in rules.json; all appearance lives in visuals.json.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
