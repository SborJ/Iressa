      "id": "CDK_ESCAPE",
      "label": "CDK4/6 escape (RB1 loss / CCNE1)",
      "parent": "ESR1_WT",
      "resistant": true
    }
  ],
  "default_clone_weights": [
    99.0,
    0.5,
    0.5,
    0.0
