    {
      "id": "ESR1_WT",
      "label": "ER-sensitive (ESR1 wild type)",
      "parent": null,
      "resistant": false
    },
    {
      "id": "ESR1_Y537S",
      "label": "ESR1 Y537S",
      "parent": "ESR1_WT",
      "resistant": true
    },
