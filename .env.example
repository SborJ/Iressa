# Supabase project settings for the simulator's sign-in.
# Copy to .env.local (git-ignored) and fill in from
# Supabase dashboard -> Project Settings -> API.
#
# Use the public "anon" / publishable key only. Never put the service-role
# (secret) key in any VITE_ variable: everything VITE_ ships to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to true once the ORCID sign-in provider exists in Supabase
# (scripts/setup-orcid-provider.mjs). Until then the ORCID button is hidden.
VITE_ORCID_ENABLED=false
